:80 {
	try_handle {
		max_attempts 3
		fallback_status 502 503 5xx
		error_status 503
		error_match @retryable
		on_exhausted commit
		request_body_buffer 1MB
		response_body_buffer 10MB

		@retryable expression {http.error.message}.startsWith("dial")
		@slow {
			status 504
			header Retry-After *
		}
		fallback_match @slow

		handle /cache/* {
			reverse_proxy 127.0.0.1:9001
		}
		handle_path /api/* {
			reverse_proxy 127.0.0.1:9002
		}
		handle {
			respond "maintenance" 503
		}
	}
}
