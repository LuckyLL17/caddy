{
	servers :9080 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.0/8
				fallback_policy REQUIRE
				policy {
					versions 1 2
					max_header_size 4KiB
					missing reject
					malformed allow
					address {
						remote header
						local peer
					}
					tlv {
						default reject
						accept ALPN AUTHORITY
						discard 0xE0
						reject SSL
					}
				}
			}
		}
	}
}

:9080 {
	respond "ok"
}
